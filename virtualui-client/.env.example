# VirtualUI frontend environment variables
# Copy this file to .env and fill in your values.

# Backend API base URL
VITE_API_URL=https://ai-powered-virtual-ui-library.onrender.com

# Firebase (Google Auth) - from Firebase console
VITE_FIREBASE_APIKEY=your-firebase-api-key

# Razorpay (payments) - from Razorpay dashboard
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id
